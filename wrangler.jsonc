{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hostamble-redesign",
  "compatibility_date": "2026-10-31",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  },
  "build": { "command": "npm run build" }
}
