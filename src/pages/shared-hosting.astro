---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PricingGrid from '../components/PricingGrid.astro';
import DomainSearch from '../components/DomainSearch.astro';
import ContactCTA from '../components/ContactCTA.astro';
import FeatureCards from '../components/FeatureCards.astro';
import InfoSplit from '../components/InfoSplit.astro';
import StepsSection from '../components/StepsSection.astro';
import FAQSection from '../components/FAQSection.astro';
---
<BaseLayout title="Shared Web Hosting Plans | Hostamble" description="Explore Hostamble shared hosting plans, cPanel, NVMe storage, bandwidth limits, billing periods, and getting your first website online.">
  <PageHero eyebrow="SHARED HOSTING" title="Your first website deserves a great home." description="A straightforward starting point for portfolios, blogs, and growing business sites. Compare the essentials and move at your own pace." icon="▦" />
  <FeatureCards
    eyebrow="THE EVERYDAY ESSENTIALS"
    title="A good foundation for"
    accent="what's next."
    description="Clear building blocks for websites that don't need a dedicated server. Current package details and renewal terms should be reviewed before ordering."
    tone="cream"
    items={[
      {tag:'01 / STORAGE',symbol:'▦',title:'Space for your files',text:'The published shared plans list 4 GB to 25 GB of NVMe storage, depending on the tier you select.'},
      {tag:'02 / TOOLS',symbol:'⌘',title:'Familiar cPanel access',text:'Manage common hosting tasks through cPanel on the listed shared hosting plans.'},
      {tag:'03 / PROTECTION',symbol:'✓',title:'SSL and backups',text:'SSL and daily JetBackup appear in the listed plans. Check current daily backup retention (last three days) and restoration terms before ordering.'}
    ]}
  />
  <PricingGrid family="shared" heading="Find your kind of hosting." description="Compare explicit monthly, quarterly, semiannual, and annual totals. Check the billing period, resource limits and final price before completing your order."/>
  <InfoSplit
    eyebrow="PICK YOUR FIT"
    title="Start small."
    accent="Leave room to grow."
    paragraphs={['You do not need the biggest plan to publish a first website. Think about the number of sites, how much storage you expect to use, and whether your bandwidth needs may change.', 'The plan comparison lists Basic for one website, Starter for up to three, and Elite for up to ten. Confirm those limits at checkout and check current limits before purchase.']}
    points={['Basic — a single-site starting point','Starter — several websites in one account','Elite — more sites and a larger listed allocation']}
    panelLabel="CHOOSE WITH CONFIDENCE"
    panelTitle="Plan around your websites, not guesses."
    panelText="The best fit is the one whose current published limits match the sites you plan to host."
    panelSymbol="▦"
    href="#pricing"
    actionLabel="Compare plans above"
  />
  <StepsSection
    eyebrow="LAUNCH IN THREE STEPS"
    title="From blank page to"
    accent="your new website."
    description="A sensible route from choosing a plan to checking that your website is ready to share."
    steps={[
      {title:'Review your plan',text:'Compare site allowances, storage, bandwidth and billing-period totals. Check the product details before ordering.'},
      {title:'Connect a domain',text:'Use a domain you already own or search for a new name and check live availability.'},
      {title:'Publish and check',text:'Follow the hosting setup details, upload your site or install your software, and test your pages and SSL.'}
    ]}
    href="/guides"
    actionLabel="Read starter guides"
  />
  <FAQSection
    eyebrow="SHARED HOSTING FAQ"
    title="Questions?"
    accent="We're here."
    intro="Everything worth asking before you select a shared hosting plan."
    questions={[
      {question:'How many websites can each plan host?',answer:'The current plan list shows one site for Basic, three for Starter, and ten for Elite. Confirm resource limits and renewal terms before purchase.'},
      {question:'Is SSL included?',answer:'SSL and Imunify360 are included with the shared hosting offering. Check configuration details for your domain.'},
      {question:'How is the six-month offer applied?',answer:'The free .us.cc domain offer is for qualifying six-month hosting. Registration duration, renewal fees and exact eligible plans are pending confirmation.'},
      {question:'Can I compare the full billing totals?',answer:'Yes. Select Monthly, 3 months, 6 months, or Yearly above to see the corresponding published total in Indian rupees. Checkout remains the final billing authority.'},
      {question:'Where can I get help with account access?',answer:'Use Hostamble’s existing client area for account management or visit the support page for help options.'}
    ]}
  />
  <DomainSearch compact />
  <ContactCTA title="Ready to give your website a home?" text="Compare your options, search for a domain, or ask the team about the right shared hosting plan."/>
</BaseLayout>
