---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContactCTA from '../components/ContactCTA.astro';
---
<BaseLayout title="Business Email Solutions | Hostamble" description="Explore business email options with Hostamble and contact the team for verified availability, features and pricing.">
  <PageHero eyebrow="BUSINESS EMAIL" title="Big ideas deserve an inbox to match." description="Show up with an email address on your own domain. Talk with the Hostamble team about suitable options and current pricing." icon="@"/>
  <section class="inquiry-section section-pad"><div class="container inquiry-grid"><div><span class="eyebrow"><span class="eyebrow-line"></span> WORK SMARTER</span><h2>Put your domain <em>to work.</em></h2><p>Business email can help your brand communicate with consistency. Product specifications and dedicated email package prices have not yet been verified for this redesign.</p></div><div class="inquiry-card"><span class="inquiry-icon">@</span><h3>Let's find your email setup.</h3><p>Ask about mailboxes, storage, migration options, access methods, and the current quote before ordering.</p><a class="button button-dark" href="mailto:support@hostamble.com?subject=Business%20email%20enquiry">Enquire about email ↗</a><p class="inquiry-footnote">No prices or delivery guarantees are assumed.</p></div></div></section>
  <ContactCTA />
</BaseLayout>
