---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContactCTA from '../components/ContactCTA.astro';
---
<SiteLayout title="About Hostamble | Hosting & Support" description="Learn about Hostamble hosting for bloggers, WordPress users and smaller businesses." canonicalPath="/about-us.html">
<PageHero title="About Hostamble" eyebrow="OUR APPROACH" description="Hosting for bloggers, WordPress site owners and small businesses in India and internationally." />
<section class="ace-services-area bg-image ace-section-gap hostamble-content"><div class="container"><div class="section-title text-center"><span class="pre-title">What we do</span><h2 class="title">A practical home for your website</h2></div><div class="row g-5"><div class="col-md-4"><h3>Hosting</h3><p>We provide Shared and WordPress hosting with NVMe SSD, LiteSpeed, cPanel, SSL, Imunify360 and daily JetBackup.</p></div><div class="col-md-4"><h3>Domains</h3><p>Find, register and transfer domains using the existing domain checkout service.</p></div><div class="col-md-4"><h3>Support</h3><p>Live chat and WhatsApp: Monday–Saturday, 9 AM–8 PM IST. Support tickets can be submitted at any time.</p></div></div></div></section>
<ContactCTA />
</SiteLayout>
