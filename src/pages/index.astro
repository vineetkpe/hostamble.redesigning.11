---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import DomainSearch from '../components/DomainSearch.astro';
import ProductGrid from '../components/ProductGrid.astro';
import PricingGrid from '../components/PricingGrid.astro';
import ContactCTA from '../components/ContactCTA.astro';
import StepsSection from '../components/StepsSection.astro';
import ServiceChooser from '../components/ServiceChooser.astro';
import FAQSection from '../components/FAQSection.astro';
---
<BaseLayout title="Hostamble — Make room for your next big idea" description="Bring your ideas online with shared hosting, WordPress hosting, domains, business email, and VPS options from Hostamble.">
  <Hero />
  <div class="trust-strip"><div class="container"><span>THE LITTLE THINGS MATTER</span><span>✳ cPanel on listed shared plans</span><span>✳ SSL included</span><span>✳ Backup tools</span><span>✳ Domain discovery</span></div></div>
  <ProductGrid />
  <DomainSearch />
  <StepsSection
    eyebrow="YOUR JOURNEY, SIMPLIFIED"
    title="From an idea to"
    accent="your own little corner."
    description="You don't need to have everything figured out. Start with a name, choose the space you need, and manage it in one familiar client area."
    steps={[
      {title:'Find your name',text:'Search your preferred domain and check live availability in Hostamble’s domain system.'},
      {title:'Choose your hosting',text:'Compare the website limits, storage, and billing periods that suit your project.'},
      {title:'Make it yours',text:'Complete any purchase in the existing secure client area and follow your service setup instructions.'}
    ]}
    href="/guides"
    actionLabel="Explore getting-started guides"
  />
  <PricingGrid family="shared" eyebrow="PLANS THAT MAKE SENSE" heading="More value. Less figuring things out." description="Start with the space you need. Compare plans and take the next step at Hostamble's secure checkout."/>
  <section class="promo-section section-pad"><div class="container"><div class="promo-grid">
    <div class="promo-art" aria-hidden="true"><span class="promo-orbit">✳</span><div class="promo-domain">youridea<span>.us.cc</span></div><div class="promo-badge">A LITTLE BONUS ↗</div></div>
    <div><span class="eyebrow"><span class="eyebrow-line"></span> MAKE IT YOURS</span><h2>Even more reasons to <em>launch that idea.</em></h2><p>Look out for Hostamble's .US.CC domain promotion with eligible semiannual hosting. Promotion terms and domain eligibility are confirmed at checkout.</p><a class="button button-dark" href="/shared-hosting">See hosting options ↗</a></div>
  </div></div></section>
  <section class="value-section section-pad"><div class="container"><div class="section-intro"><span class="eyebrow"><span class="eyebrow-line"></span> BUILT AROUND YOU</span><h2>Less hosting jargon. <em>More getting things done.</em></h2></div><div class="value-grid">
    <article><span class="value-icon">01 ✳</span><h3>Get online faster</h3><p>From finding your name to choosing your hosting, everything begins with a clear next step.</p></article>
    <article><span class="value-icon">02 ◇</span><h3>Tools that make sense</h3><p>Selected shared hosting plans include familiar cPanel access, SSL, and backup tools.</p></article>
    <article><span class="value-icon">03 ↗</span><h3>Grow at your pace</h3><p>Start with a single website, explore WordPress, or enquire about a VPS when you're ready.</p></article>
  </div></div></section>
  <ServiceChooser />
  <FAQSection
    eyebrow="YOUR QUESTIONS"
    title="A few things worth"
    accent="knowing first."
    intro="A helpful starting point before you choose hosting or register your next domain."
    questions={[
      {question:'Can I start with just a domain?',answer:'Yes. Search a domain and continue to Hostamble’s domain registration checkout. Availability, promotional rules, and final charges are shown there.'},
      {question:'What if I want to use WordPress?',answer:'Explore the dedicated WordPress hosting plans and compare monthly or annual totals. Current service specifications should be confirmed at checkout.'},
      {question:'Does choosing a billing cycle change the total?',answer:'Yes. The pricing selector shows the explicit total for each published billing period; it does not calculate or promise discounts.'},
      {question:'Where do I manage my services?',answer:'Hostamble’s existing client area handles account and billing management. Use the Log in link in the navigation.'}
    ]}
  />
  <ContactCTA />
</BaseLayout>
