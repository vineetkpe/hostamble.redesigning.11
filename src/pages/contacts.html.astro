---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/PageHero.astro';
---
<SiteLayout title="Contact Hostamble | Live Chat, WhatsApp & Tickets" description="Hostamble chat and WhatsApp operate Monday\u2013Saturday, 9 AM\u20138 PM IST. Tickets can be submitted anytime with a reply within 12 hours." canonicalPath="/contacts.html">
<PageHero title="Contact Hostamble support" eyebrow="CONTACT & SUPPORT" description="Choose live chat, WhatsApp, a support ticket or email for help with your website or account." />
<section class="ace-contact-us-area aceorbit-contact-us ace-section-gap bg-color-white hostamble-content"><div class="container"><div class="section-title text-center"><h2 class="title">How to reach us</h2></div><div class="row g-5"><div class="col-lg-4"><h3>Live chat & WhatsApp</h3><p>Monday–Saturday, 9 AM–8 PM IST.</p><p>Ask for the current verified WhatsApp/chat destination through the client area.</p></div><div class="col-lg-4"><h3>Support tickets</h3><p>Submit tickets anytime, with a reply within 12 hours. This does not guarantee resolution within 12 hours.</p><a class="ace-btn btn-secondary" href="https://hostamble.com/dash/clientarea.php">Open client area</a></div><div class="col-lg-4"><h3>Email support</h3><p>Contact our team with your hosting or domain question.</p><a class="ace-btn btn-secondary" href="mailto:support@hostamble.com">support@hostamble.com</a></div></div></div></section>
</SiteLayout>
