---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout title="Hostamble | Web Hosting And Domains" description=" cheap web hosting at cheap price , best cheap hosting , best cheap web hosting in india , best web hosting for small business " canonicalPath="/contacts.html">
<div class="slider-area banner banner-style-two bg-image d-flex align-items-center height-800">
<div class="container">
<div class="row g-5 align-items-center">
<div class="col-lg-6 col-md-12">
<div class="inner">
<div class="content">
<h1 class="title" data-sal="slide-up" data-sal-delay="200" data-sal-duration="800">
                               Contact Now
                           </h1>
<p class="description mb-4" data-sal="slide-up" data-sal-delay="250" data-sal-duration="800">
                              Easily accessible customer service is crucial in today's , online business environment Hostamble's experienced team Members. 
                           </p>
<div class="read-more-btn" data-sal="slide-up" data-sal-delay="300" data-sal-duration="800">
<a class="ace-btn" href="#plans">Get Started Today <i class="icon-arrow-right-line-right"></i></a>
</div>
</div>
</div>
</div>
<div class="col-lg-6">
<div class="banner-thumbnail">
<img alt="Banner Images" class="img-thumb" data-sal="fade" data-sal-delay="150" data-sal-duration="800" src="/assets/images/banner04.png"/>
</div>
</div>
</div>
<div class="shape-dot-wrapper shape-wrapper d-xl-block d-none">
<div class="shape-image shape-image-1">
<img alt="Shape Thumb" src="/assets/images/shape1108.png"/>
</div>
<div class="shape-image shape-image-2">
<img alt="Shape Thumb" src="/assets/images/shape03.png"/>
</div>
<div class="shape-image shape-image-3">
<img alt="Shape Thumb" src="/assets/images/shape2302.png"/>
</div>
</div>
</div>
</div>
<div class="ace-contact-us-area aceorbit-contact-us ace-section-gap bg-color-white" id="plans">
<div class="container aceorbit-animated-shape">
<div class="row g-5">
<div class="col-lg-12">
<div class="section-title text-center" data-sal="slide-up" data-sal-delay="150" data-sal-duration="800">
<span class="pre-title">Need Help?</span>
<h3 class="title">Get In Touch With us</h3>
</div>
</div>
</div>
<div class="row g-5 mt--20">
<div class="col-lg-6">
<div class="contact-info pr--70 pr_lg--0 pr_md--0 pr_sm--0">
<div class="row g-5">
<div class="col-lg-6 col-md-6 col-sm-6 col-12" data-sal="slide-up" data-sal-delay="150" data-sal-duration="800">
<div class="contact-address-card-1 website">
<div class="inner">
<div class="icon">
<i class="ri-global-line"></i>
</div>
<div class="content">
<h6 class="title">Sales</h6>
<p><a href="tel:1234567890" target="_blank">Phone: 91 628 471 9083</a></p>
<p><a href="mailto:support@hostamble.com" target="_blank">Mail: support@hostamble.com</a></p>
</div>
</div>
</div>
</div>
<div class="col-lg-6 col-md-6 col-sm-6 col-12" data-sal="slide-up" data-sal-delay="200" data-sal-duration="800">
<div class="contact-address-card-1 phone">
<div class="inner">
<div class="icon">
<i class="icon-mail-open-line"></i>
</div>
<div class="content">
<h6 class="title">Billing</h6>
<p><a href="mailto:billing@hostamble.in" target="_blank">Mail: billing@hostamble.in</a></p>
</div>
</div>
</div>
</div>
<div class="col-lg-6 col-md-6 col-sm-6 col-12" data-sal="slide-up" data-sal-delay="250" data-sal-duration="800">
<div class="contact-address-card-1 email">
<div class="inner">
<div class="icon">
<i class="icon-Headphone"></i>
</div>
<div class="content">
<h6 class="title">Technical</h6>
<p><a href="tel:1234567890" target="_blank">Phone: 91 628 471 9083</a></p>
<p><a href="mailto:support@hostamble.com" target="_blank">Mail: support@hostamble.com</a></p>
</div>
</div>
</div>
</div>
<div class="col-lg-6 col-md-6 col-sm-6 col-12" data-sal="slide-up" data-sal-delay="300" data-sal-duration="800">
<div class="contact-address-card-1 location">
<div class="inner">
<div class="icon">
<i class="icon-map-pin-line"></i>
</div>
<div class="content">
<h6 class="title">Our Location</h6>
<p>Asia , India</p>
</div>
</div>
</div>
</div>
</div>
</div>
</div>
<div class="col-lg-6">
<p class="hostamble-form-handoff">To send your message securely, continue to the Hostamble contact page. This preview does not submit account data.</p><form action="https://hostamble.com/dash/contact.php" class="rnt-contact-form rwt-dynamic-form row" id="contact-form" method="get">
<div class="col-lg-12">
<div class="form-group">
<input class="form-control form-control-lg" id="contact-name" name="contact-name" placeholder="Name*" type="text"/>
</div>
</div>
<div class="col-lg-12">
<div class="form-group">
<input class="form-control form-control-lg" id="contact-email" name="contact-email" placeholder="Email*" type="email"/>
</div>
</div>
<div class="col-lg-12">
<div class="form-group">
<input class="form-control form-control-lg" id="contact-phone" name="contact-phone" placeholder="Phone" type="text"/>
</div>
</div>
<div class="col-lg-12">
<div class="form-group">
<input class="form-control form-control-lg" id="subject" name="subject" placeholder="Subject" type="text"/>
</div>
</div>
<div class="col-lg-12">
<div class="form-group">
<textarea class="form-control" id="contact-message" name="contact-message" placeholder="Your Message"></textarea>
</div>
</div>
<div class="col-lg-12">
<button class="ace-btn w-100 mt-3" type="submit">
                                    Contact Now <i class="icon-arrow-right-line-right"></i>
</button>
</div></form>
</div>
</div>
<div class="shape-dot-wrapper shape-wrapper d-xl-block d-none">
<div class="shape-image scene shape-image-1">
<span data-depth="-2.2">
<img alt="Shape Thumb" src="/assets/images/shape0401.png"/>
</span>
</div>
<div class="shape-image shape-image-2">
<img alt="Shape Thumb" src="/assets/images/shape0208.png"/>
</div>
<div class="shape-image shape-image-3">
<img alt="Shape Thumb" src="/assets/images/shape15.png"/>
</div>
</div>
</div>
</div>
</SiteLayout>
