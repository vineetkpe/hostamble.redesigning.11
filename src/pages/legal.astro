---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
---
<BaseLayout title="Legal & Policies | Hostamble" description="Find Hostamble's existing published terms, privacy information, and refund and cancellation policy.">
  <PageHero eyebrow="POLICIES" title="The important details, in one place." description="Before purchasing, review the currently published Hostamble terms and policies." icon="§"/>
  <section class="support-section section-pad"><div class="container"><div class="support-grid">
    <div class="support-card" id="terms"><span>01 ↗</span><h2>Terms & conditions</h2><p>A live, verified document link is not yet available. Contact support for the current agreement.</p><b>Request current terms from support</b></div>
    <div class="support-card" id="privacy"><span>02 ↗</span><h2>Privacy policy</h2><p>A live, verified document link is not yet available. Contact support for the current policy.</p><b>Request current privacy policy from support</b></div>
    <a class="support-card" href="https://www.hostamble.com/refund-and-cancellation-policy"><span>03 ↗</span><h2>Refunds & cancellations</h2><p>Review the existing refund and cancellation terms before ordering.</p><b>Read policy →</b></a>
  </div><p class="price-footnote">Refund and cancellation terms link to the published policy. Terms, privacy and SLA documents still need verified public links.</p></div></section>
</BaseLayout>
