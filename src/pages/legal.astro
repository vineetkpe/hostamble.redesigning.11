---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
---
<BaseLayout title="Legal & Policies | Hostamble" description="Find Hostamble's existing published terms, privacy information, and refund and cancellation policy.">
  <PageHero eyebrow="POLICIES" title="The important details, in one place." description="Before purchasing, review the currently published Hostamble terms and policies." icon="§"/>
  <section class="support-section section-pad"><div class="container"><div class="support-grid">
    <a class="support-card" href="https://www.hostamble.com/legal-agreement"><span>01 ↗</span><h2>Terms & conditions</h2><p>Read Hostamble's current legal agreement on the existing site.</p><b>Read terms →</b></a>
    <a class="support-card" href="https://www.hostamble.com/privacy-policy"><span>02 ↗</span><h2>Privacy policy</h2><p>Review the existing privacy policy and how data is described.</p><b>Read privacy policy →</b></a>
    <a class="support-card" href="https://www.hostamble.com/refund-and-cancellation-policy"><span>03 ↗</span><h2>Refunds & cancellations</h2><p>Review the existing refund and cancellation terms before ordering.</p><b>Read policy →</b></a>
  </div><p class="price-footnote">These existing policies are linked rather than republished without legal review. Their final canonical homes must be set before launch.</p></div></section>
</BaseLayout>
