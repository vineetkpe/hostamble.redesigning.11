---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/PageHero.astro';
import DomainSearch from '../components/DomainSearch.astro';
import DomainPrices from '../components/DomainPrices.astro';
import ContactCTA from '../components/ContactCTA.astro';
---
<SiteLayout title="Domain Registration & Renewal Prices | Hostamble" description="Check domain availability and compare INR registration and renewal rates for popular extensions." canonicalPath="/domain-search.html">
<PageHero title="Find your domain name" eyebrow="DOMAINS" description="Search availability, review registration and renewal costs, and register your domain through the client area." />
<section class="ace-domain-area ace-section-gap bg-image hostamble-content"><div class="container"><div class="section-title text-center"><span class="pre-title">Domain search</span><h2 class="title">Search an available domain</h2></div><DomainSearch /></div></section>
<DomainPrices />
<section class="ace-services-area bg-image ace-section-gap hostamble-content"><div class="container"><div class="section-title text-center"><h2 class="title">Understand the full domain cost</h2></div><div class="row g-5"><div class="col-md-4"><h3>Registration</h3><p>Review the extension, first-year amount and registration period. Names must be checked for availability.</p></div><div class="col-md-4"><h3>Renewal</h3><p>Annual renewal prices can differ from promotional first-year prices. Check renewal terms for your extension.</p></div><div class="col-md-4"><h3>DNS and privacy</h3><p>DNS controls and domain privacy vary by domain and service. Verify what applies during checkout or with support.</p></div></div></div></section>
<ContactCTA />
</SiteLayout>
