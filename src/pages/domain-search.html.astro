---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout title="Hostamble | Web Hosting And Domains" description=" cheap web hosting at cheap price , best cheap hosting , best cheap web hosting in india , best web hosting for small business " canonicalPath="/domain-search.html">
<div class="aceorbit-domain-search domain-search ace-domain-area domain-style-4 bg-image banner d-flex align-items-center height-800" id="plans">
<div class="container aceorbit-animated-shape">
<div class="row">
<div class="col-lg-12">
<div class="inner text-center" data-sal="slide-up" data-sal-delay="150" data-sal-duration="800">
<div class="content" data-sal="slide-up" data-sal-delay="150" data-sal-duration="800">
<h1 class="title" data-sal="slide-up" data-sal-delay="200" data-sal-duration="800">
                              Domain Name Registration
                           </h1>
<p class="description" data-sal="slide-up" data-sal-delay="250" data-sal-duration="800">
                              To search for domains, type your desired domains name on a separate line and choose your extensions
                           </p>
</div>
<div class="domain-form domain-form-style-1 mt--60 mt_md--30 mt_sm--30 position-relative">
<form action="https://hostamble.com/dash/cart.php" class="input-box text-start" method="get"><input name="a" type="hidden" value="add"/><input name="domain" type="hidden" value="register"/>
<input class="large-input-box" name="query" placeholder="Find Your Ideal Domain Name ..." type="search"/>
<div class="mail-icon">
<i class="icon-Browser"></i>
</div>
<button class="ace-btn" type="submit">Search Now<i class="icon-arrow-right-line-right"></i></button>
</form>
</div>
<ul class="select-tlds">
<li>
<span class="name">.com</span>
<span class="original-price prices">₹1265</span>
<span class="discount-price prices">₹999</span>
</li>
<li>
<span class="name">.net</span>
<span class="original-price prices">₹1679</span>
<span class="discount-price prices">₹1399</span>
</li>
<li>
<span class="name">.online</span>
<span class="original-price prices">₹643</span>
<span class="discount-price prices">₹139</span>
</li>
<li>
<span class="name">.in</span>
<span class="original-price prices">₹883</span>
<span class="discount-price prices">₹699</span>
</li>
<li>
<span class="name">.Co.in</span>
<span class="original-price prices">₹723</span>
<span class="discount-price prices">₹499</span>
</li>
</ul>
</div>
</div>
</div>
