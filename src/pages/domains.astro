---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import DomainSearch from '../components/DomainSearch.astro';
import ContactCTA from '../components/ContactCTA.astro';
import FeatureCards from '../components/FeatureCards.astro';
import InfoSplit from '../components/InfoSplit.astro';
import StepsSection from '../components/StepsSection.astro';
import FAQSection from '../components/FAQSection.astro';
import catalog from '../data/catalog.json';
import {formatINR} from '../lib/pricing.mjs';
---
<BaseLayout title="Domain Registration & Renewal | Hostamble" description="Search domain names, understand registration and renewal prices, compare extensions, and learn how to transfer a domain with Hostamble.">
  <PageHero eyebrow="DOMAINS" title="Every great idea deserves a name." description="Find a name that sounds like you, then check live availability through Hostamble's domain registration system." icon="↗"/>
  <DomainSearch compact />
  <FeatureCards
    eyebrow="FIND YOUR MATCH"
    title="One name."
    accent="So many possibilities."
    description="The best extension depends on the audience, the name you want, and its long-term renewal cost."
    tone="white"
    items={[
      {tag:'01 / FAMILIAR',symbol:'.com',title:'A recognizable classic',text:'.com is widely familiar and can suit a wide range of projects. Registration depends on live availability.'},
      {tag:'02 / LOCAL',symbol:'.in',title:'A name with an Indian connection',text:'.in may feel right when your website is aimed at people, customers or communities in India.'},
      {tag:'03 / ALTERNATIVES',symbol:'↗',title:'More ways to stand out',text:'.online and .site are alternatives worth comparing, especially because their renewal prices differ from introductory registration costs.'}
    ]}
  />
  <section class="domain-price-section section-pad">
    <div class="container">
      <div class="section-intro split-intro">
        <div><span class="eyebrow"><span class="eyebrow-line"></span> REGISTRATION & RENEWAL</span><h2>Look beyond the <em>first-year price.</em></h2></div>
        <p>Indicative domain prices captured 31 October 2026. Promotions, registry changes, premium names, and taxes may affect live pricing.</p>
      </div>
      <div class="domain-price-table" role="region" aria-label="Domain pricing table" tabindex="0">
        <table>
          <thead><tr><th scope="col">Extension</th><th scope="col">Register / first year</th><th scope="col">Renewal / year</th><th scope="col"><span class="sr-only">Action</span></th></tr></thead>
          <tbody>{catalog.domains.map(domain => <tr>
            <th scope="row">{domain.tld}</th>
            <td data-domain-money={domain.registerPaise}>{formatINR(domain.registerPaise)}</td>
            <td data-domain-money={domain.renewPaise}>{formatINR(domain.renewPaise)}</td>
            <td><a href={catalog.checkout.domainPrices}>Check live pricing ↗</a></td>
          </tr>)}</tbody>
        </table>
      </div>
      <p class="currency-note" data-domain-currency-note>Prices shown in INR. Confirm final prices during checkout.</p>
      <div class="domain-bottom-actions"><a class="button button-dark" href={catalog.checkout.domainTransfer}>Transfer a domain ↗</a><a class="text-link" href={catalog.checkout.domainPrices}>See all extensions →</a></div>
    </div>
  </section>
  <InfoSplit
    eyebrow="SMART DOMAIN CHOICES"
    title="A little planning goes"
    accent="a long way."
    paragraphs={['A domain is more than an address: it is something visitors type, remember and share. Prefer spelling that people can repeat without needing an explanation.', 'Check the renewal amount, registration term, and any transfer conditions before paying. The promotional .us.cc offer tied to eligible six-month hosting is not the same as a universally free standalone domain.']}
    points={['Keep spelling and pronunciation simple','Review both first-year and renewal totals','Confirm live availability and any restrictions']}
    panelLabel="YOUR NAME, YOUR IDEA"
    panelTitle="Clear today. Memorable tomorrow."
    panelText="Choose a domain you will still feel good about using after the introductory period."
    panelSymbol="@"
    href={catalog.checkout.domainPrices}
    actionLabel="View live pricing"
  />
  <StepsSection
    eyebrow="FROM SEARCH TO SETUP"
    title="Your domain journey,"
    accent="made simpler."
    steps={[
      {title:'Search a name',text:'Enter the complete domain name you prefer, including the extension, and continue to the live domain checker.'},
      {title:'Compare options',text:'Review availability, premium-name indicators, first-year price and renewal terms in checkout.'},
      {title:'Complete registration',text:'Follow the registration process in Hostamble’s existing client area; no purchase happens on this marketing page.'},
      {title:'Connect your website',text:'After registration, review DNS and nameserver instructions for the hosting service you intend to use.'}
    ]}
    href="#domain-search"
    actionLabel="Search a domain"
  />
  <FAQSection
    eyebrow="DOMAIN FAQ"
    title="All the small"
    accent="domain details."
    intro="What to check before you register or transfer a name."
    questions={[
      {question:'Does searching a domain reserve it?',answer:'No. The search form hands your query to the WHMCS checker. The name is only registered after you complete the separate registration and payment process.'},
      {question:'Why is renewal different from registration?',answer:'Extensions may have an introductory registration price and a different renewal rate. Review both amounts and any promotion terms before purchasing.'},
      {question:'Can I transfer an existing domain?',answer:'The Transfer a domain link opens Hostamble’s existing transfer flow. Eligibility and transfer requirements depend on the extension and registry rules.'},
      {question:'Is the .us.cc promotion available for every domain?',answer:'No. The free .us.cc domain offer is advertised with semiannual hosting, not as a standalone free registration.'}
    ]}
  />
  <ContactCTA title="That perfect domain starts with a search." text="Check a name, compare renewal terms, and ask for help if you need to transfer an existing domain." />
</BaseLayout>
