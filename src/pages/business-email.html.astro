---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContactCTA from '../components/ContactCTA.astro';
---
<SiteLayout title="Business Email Enquiries | Hostamble" description="Ask about current professional email packages, mailbox allowances, setup and pricing." canonicalPath="/business-email.html">
<PageHero title="Business Email" eyebrow="EMAIL FOR YOUR DOMAIN" description="Use your business domain for professional email. Contact the team for a current quote and mailbox specifications." />
<section class="ace-services-area bg-image ace-section-gap hostamble-content"><div class="container"><div class="section-title text-center"><h2 class="title">Ask about business email packages</h2><p>Business Email is a separate paid service from any mailboxes included in a hosting plan. Current account limits, mailbox storage, access methods, spam protection and pricing need confirmation.</p></div><div class="text-center"><a class="ace-btn" href="mailto:support@hostamble.com?subject=Business%20Email%20Enquiry">Request business email details</a></div></div></section><ContactCTA />
</SiteLayout>
