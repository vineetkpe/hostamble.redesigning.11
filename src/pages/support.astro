---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import catalog from '../data/catalog.json';
---
<BaseLayout title="Help & Support | Hostamble" description="Reach Hostamble support, open your client account, or find links for domain and hosting assistance.">
  <PageHero eyebrow="SUPPORT" title="We're in your corner." description="Have a question about hosting, billing, or domains? Start with the right support channel." icon="?"/>
  <section class="support-section section-pad"><div class="container"><div class="section-intro"><span class="eyebrow"><span class="eyebrow-line"></span> LET'S SORT IT OUT</span><h2>How can we <em>help today?</em></h2></div><div class="support-grid">
    <a class="support-card" href={catalog.checkout.login}><span>01 ↗</span><h3>Client area</h3><p>Sign in to manage your Hostamble account and access available support options.</p><b>Open client area →</b></a>
    <a class="support-card" href="mailto:support@hostamble.com"><span>02 @</span><h3>Email support</h3><p>Send a message to support@hostamble.com with your question.</p><b>Write an email →</b></a>
    <a class="support-card" href="/guides"><span>03 ✳</span><h3>Explore guides</h3><p>Start with basic guidance on domains, choosing a plan, and launching a website.</p><b>Read guides →</b></a>
  </div></div></section>
</BaseLayout>
