---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout title="Hostamble | Web Hosting And Domains" description=" cheap web hosting at cheap price , best cheap hosting , best cheap web hosting in india , best web hosting for small business " canonicalPath="/transfer-domain.html">
<div class="aceorbit-domain-search domain-search ace-domain-area domain-style-4 bg-image banner d-flex align-items-center height-800" id="plans">
<div class="container aceorbit-animated-shape">
<div class="row">
<div class="col-lg-12">
<div class="inner text-center" data-sal="slide-up" data-sal-delay="150" data-sal-duration="800">
<div class="content" data-sal="slide-up" data-sal-delay="150" data-sal-duration="800">
<h1 class="title" data-sal="slide-up" data-sal-delay="200" data-sal-duration="800">
                              Domain Name Transfer
                           </h1>
<p class="description" data-sal="slide-up" data-sal-delay="250" data-sal-duration="800">
                              Browse our step-by-step guide for domain transfers to ensure a quick and easy transfer. 
                           </p>
</div>
<div class="domain-form domain-form-style-1 mt--60 mt_md--30 mt_sm--30 position-relative">
<form action="https://hostamble.com/dash/cart.php" class="input-box text-start" method="get"><input name="a" type="hidden" value="add"/><input name="domain" type="hidden" value="transfer"/>
<input class="large-input-box" name="query" placeholder="Find Your Ideal Domain Name ..." type="search"/>
<div class="mail-icon">
<i class="icon-Browser"></i>
</div>
<button class="ace-btn" type="submit">Transfer Now<i class="icon-arrow-right-line-right"></i></button>
</form>
</div>
<ul class="select-tlds">
<li>
<span class="name">.com</span>
<span class="original-price prices">₹1794</span>
<span class="discount-price prices">₹986</span>
</li>
<li>
<span class="name">.net</span>
<span class="original-price prices">₹1899</span>
<span class="discount-price prices">₹599</span>
</li>
<li>
<span class="name">.org.in</span>
<span class="original-price prices">₹1299</span>
<span class="discount-price prices">₹499</span>
</li>
<li>
<span class="name">.in</span>
<span class="original-price prices">₹867</span>
<span class="discount-price prices">₹699</span>
</li>
<li>
<span class="name">.Co.in</span>
<span class="original-price prices">₹987</span>
<span class="discount-price prices">₹699</span>
</li>
</ul>
</div>
</div>
</div>
<div class="shape-dot-wrapper shape-wrapper d-xl-block d-none">
<div class="shape-image shape-image-1">
<img alt="Shape Thumb" src="/assets/images/www.png"/>
</div>
<div class="shape-image shape-image-2">
<img alt="Shape Thumb" src="/assets/images/www2.png"/>
</div>
<div class="shape-image shape-image-3">
<img alt="Shape Thumb" src="/assets/images/www3.png"/>
</div>
<div class="shape-image shape-image-4">
<img alt="Shape Thumb" src="/assets/images/www4.png"/>
</div>
<div class="shape-image shape-image-5">
<img alt="Shape Thumb" src="/assets/images/www5.png"/>
</div>
<div class="shape-image shape-image-6">
<img alt="Shape Thumb" src="/assets/images/www6.png"/>
</div>
</div>
