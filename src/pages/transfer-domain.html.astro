---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/PageHero.astro';
import DomainSearch from '../components/DomainSearch.astro';
import ContactCTA from '../components/ContactCTA.astro';
---
<SiteLayout title="Domain Transfers | Eligibility & Authorization | Hostamble" description="Learn how to prepare your domain transfer and check the applicable authorization, restrictions and cost." canonicalPath="/transfer-domain.html">
<PageHero title="Transfer your domain" eyebrow="DOMAIN TRANSFER" description="Keep your domain name when switching registrars. Check eligibility, authorization and pricing before starting a transfer." />
<section class="ace-domain-area ace-section-gap bg-image hostamble-content"><div class="container"><div class="section-title text-center"><h2 class="title">Check a domain transfer</h2></div><DomainSearch transfer /></div></section>
<section class="ace-services-area bg-image ace-section-gap hostamble-content"><div class="container"><div class="section-title text-center"><span class="pre-title">Before you transfer</span><h2 class="title">Three steps to prepare</h2></div><div class="row g-5"><div class="col-md-4"><h3>1. Check eligibility</h3><p>Confirm the domain extension supports transfers and review any registry or recent-registration restrictions.</p></div><div class="col-md-4"><h3>2. Obtain authorization</h3><p>Check the current registrar's transfer lock and obtain an authorization code if required by that extension.</p></div><div class="col-md-4"><h3>3. Review checkout</h3><p>Check the actual transfer cost, renewal date and any included registration extension. These vary by extension.</p></div></div></div></section><ContactCTA />
</SiteLayout>
