---
interface Q { question: string; answer: string; }
interface Props { eyebrow?: string; title: string; accent: string; intro?: string; questions: Q[]; }
const { eyebrow = 'GOOD TO KNOW', title, accent, intro, questions } = Astro.props;
---
<section class="faq-section section-pad" aria-label={eyebrow}>
  <div class="container faq-grid">
    <div>
      <span class="eyebrow"><span class="eyebrow-line"></span>{eyebrow}</span>
      <h2>{title} <em>{accent}</em></h2>
      {intro && <p>{intro}</p>}
    </div>
    <div class="faq-list">
      {questions.map(item => <details>
        <summary>{item.question}</summary>
        <p>{item.answer}</p>
      </details>)}
    </div>
  </div>
</section>
