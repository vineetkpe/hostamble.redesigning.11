---
const {title = 'Need a hand getting started?', text = 'Chat and WhatsApp are available Monday–Saturday, 9 AM–8 PM IST. Tickets can be submitted 24/7 with replies within 12 hours.'} = Astro.props;
---
<section class="cta-section"><div class="container"><div class="cta-panel"><div><span class="eyebrow light-eyebrow">WE'RE HERE TO HELP</span><h2>{title}</h2><p>{text}</p></div><div class="cta-actions"><a class="button button-lime" href="mailto:support@hostamble.com">Email the team ↗</a><a class="text-link light-link" href="/support">Support options →</a></div></div></div></section>
