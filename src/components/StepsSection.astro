---
interface Step { title: string; text: string; }
interface Props {
  eyebrow: string;
  title: string;
  accent: string;
  description?: string;
  steps: Step[];
  tone?: 'light' | 'dark';
  href?: string;
  actionLabel?: string;
}
const { eyebrow, title, accent, description, steps, tone = 'light', href, actionLabel } = Astro.props;
---
<section class:list={['journey-section', 'section-pad', 'journey-'+tone]} aria-label={eyebrow}>
  <div class="container">
    <div class="journey-head">
      <div><span class:list={['eyebrow',tone === 'dark' && 'light-eyebrow']}><span class="eyebrow-line"></span>{eyebrow}</span><h2>{title} <em>{accent}</em></h2></div>
      {description && <p>{description}</p>}
    </div>
    <ol class="journey-steps">
      {steps.map((step,i) => <li>
        <span class="journey-number" aria-hidden="true">{String(i+1).padStart(2,'0')}</span>
        <h3>{step.title}</h3><p>{step.text}</p>
      </li>)}
    </ol>
    {href && <a class:list={['button',tone === 'dark' ? 'button-lime' : 'button-dark','journey-action']} href={href}>{actionLabel ?? 'Get started'} <span aria-hidden="true">↗</span></a>}
  </div>
</section>
