---
import catalog from '../data/catalog.json';
import {formatINR,BILLING_CYCLES} from '../lib/pricing.mjs';
type Family = 'shared'|'wordpress';
interface Props {family?:Family;heading?:string;eyebrow?:string;description?:string;showOffer?:boolean;}
const {family='shared',heading='Choose the hosting that fits',eyebrow='CLEAR PLANS',description='Compare the total for each billing period.',showOffer=family==='shared'} = Astro.props as Props;
const product=catalog.hosting[family];
const destination=family==='shared' ? catalog.checkout.sharedStore:catalog.checkout.wordpressStore;
const initialCycle='monthly' as const;
---
<section class="pricing-section section-pad" data-pricing={family} id="pricing" aria-labelledby="pricing-title">
  <div class="container">
    <div class="pricing-heading">
      <span class="eyebrow">{eyebrow}</span>
      <h2 id="pricing-title">{heading}</h2>
      <p>{description}</p>
      <div class="cycle-tabs" role="group" aria-label="Choose billing period">
        {product.cycles.map(cycle => <button type="button" data-cycle={cycle} aria-pressed={cycle===initialCycle} class:list={[cycle===initialCycle && 'active']}>{cycle==='semiannual'?'6 months':cycle==='quarterly'?'3 months':cycle==='annual'?'Annual':'Monthly'}</button>)}
      </div>
      <p class="currency-note" data-currency-note>Totals shown in INR for the selected billing period. Taxes, renewal terms and final charges are displayed before payment.</p>
      <p class="sr-only" data-price-status aria-live="polite" aria-atomic="true"></p>
    </div>
    {showOffer && <div class="pricing-promo" aria-label="Semiannual hosting domain offer">
      <div><span class="pricing-promo-eyebrow">SIX-MONTH HOSTING OFFER</span><h3>Get a free <span>.us.cc</span> domain with semiannual hosting.</h3><p>Registration length, renewal fees and eligible plans are being confirmed. Offer applies to qualifying six-month hosting, not shorter or annual plans.</p></div>
      <button type="button" class="button button-dark" data-select-semiannual>See 6-month plans <span aria-hidden="true">↓</span></button>
    </div>}
    <div class:list={['plans-grid',product.plans.length===4&&'plans-grid-four']} data-plans tabindex="-1" aria-label="Hosting plan comparison">
      {product.plans.map(plan => <article class:list={['plan-card',plan.featured&&'plan-featured']}>
        <div class="plan-topline"><span>{family==='shared'?'SHARED HOSTING':'WORDPRESS HOSTING'}</span>{plan.featured&&<span class="popular-tag">POPULAR CHOICE</span>}</div>
        <h3>{plan.name}</h3>
        <p class="plan-description">{plan.description}</p>
        <div class="plan-price"><strong data-price data-prices={JSON.stringify(plan.pricingPaise)}>{formatINR(plan.pricingPaise[initialCycle])}</strong></div>
        <p class="price-subline" data-total-note>Total due for 1 month · billed in INR</p>
        <a class:list={['button',plan.featured?'button-dark':'button-outline','plan-cta']} href={destination}>View {plan.name} in store <span aria-hidden="true">↗</span></a>
        <div class="plan-divider"></div>
        <span class="plan-includes">PLAN INCLUDES</span>
        <ul>{plan.features.map(feature=><li><span class="plan-check" aria-hidden="true">✓</span>{feature}</li>)}</ul>
      </article>)}
    </div>
    <p class="price-footnote">Plan buttons open the hosting category, where you can confirm the product, billing period, current prices and taxes before ordering.</p>
  </div>
</section>
