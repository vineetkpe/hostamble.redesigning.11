---
import catalog from '../data/catalog.json';
import {formatINR} from '../lib/pricing.mjs';
type Family = 'shared' | 'wordpress';
interface Props { family?: Family; heading?: string; eyebrow?: string; description?: string; }
const { family = 'shared', heading = 'A plan for every possibility', eyebrow = 'SIMPLE PRICING', description = 'Choose the space that fits today. Every listed price comes from one catalog.' } = Astro.props as Props;
const product = catalog.hosting[family];
const destination = family === 'shared' ? catalog.checkout.sharedStore : catalog.checkout.wordpressStore;
const initialCycle = 'monthly' as const;
const showSemiannualOffer=family==='shared' && product.cycles.includes('semiannual');
---
<section class="pricing-section section-pad" data-pricing={family} id="pricing">
  <div class="container">
    <div class="pricing-heading">
      <span class="eyebrow"><span class="eyebrow-line"></span> {eyebrow}</span>
      <h2>{heading}</h2>
      <p>{description}</p>
      <div class="cycle-tabs" role="group" aria-label="Billing period">
        {product.cycles.map(cycle => <button type="button" data-cycle={cycle} aria-pressed={cycle === initialCycle} class:list={[cycle === initialCycle && 'active']}>{cycle === 'semiannual' ? '6 months' : cycle === 'quarterly' ? '3 months' : cycle === 'annual' ? 'Yearly' : 'Monthly'}</button>)}
      </div>
      <p class="currency-note" data-currency-note>Prices in INR. Review the final total and taxes at checkout.</p>
      <p class="sr-only" data-price-status aria-live="polite" aria-atomic="true"></p>
    </div>
    {showSemiannualOffer && <div class="pricing-offer-banner" aria-label="Six-month hosting domain offer">
      <p><strong>Get a free .us.cc domain with semiannual hosting.</strong></p>
      <button type="button" class="button button-dark pricing-offer-action" data-select-semiannual>See 6-month plans <span aria-hidden="true">↗</span></button>
    </div>}
    <div class:list={['plans-grid',product.plans.length === 4 && 'plans-grid-four']}>
      {product.plans.map(plan => <article class:list={['plan-card',plan.featured && 'plan-featured']}>
        <div class="plan-topline"><span>{family === 'shared' ? 'SHARED HOSTING' : 'WORDPRESS HOSTING'}</span>{plan.featured && <span class="popular-tag">POPULAR PICK ✦</span>}</div>
        <h3>{plan.name}</h3>
        <p class="plan-description">{plan.description}</p>
        <div class="plan-price"><strong data-price data-prices={JSON.stringify(plan.pricingPaise)}>{formatINR(plan.pricingPaise[initialCycle])}</strong><span data-price-period> total for 1 month</span></div>
        <p class="price-subline" data-total-note>Billed monthly in INR</p>
        <a class:list={['button',plan.featured ? 'button-dark' : 'button-outline','plan-cta']} href={destination} rel="noopener">View plans & checkout <span aria-hidden="true">↗</span></a>
        <div class="plan-divider"></div>
        <span class="plan-includes">WHAT'S INCLUDED</span>
        <ul>{plan.features.map(feature => <li><span class="plan-check" aria-hidden="true">✓</span>{feature}</li>)}</ul>
      </article>)}
    </div>
    <p class="price-footnote">Plan names, specifications and billing prices need reconciliation with the client-area catalog. Check final details before ordering.</p>
  </div>
</section>
