---
const products = [
  {num:'01', symbol:'▦',name:'Shared hosting',text:'The friendly, affordable foundation for your website.',href:'/shared-hosting',kind:'mint'},
  {num:'02',symbol:'W',name:'WordPress hosting',text:'A home built for publishing, creating, and growing.',href:'/wordpress-hosting',kind:'peach'},
  {num:'03',symbol:'↗',name:'Domains',text:'Find a name that feels like you, from day one.',href:'/domains',kind:'lavender'},
  {num:'04',symbol:'@',name:'Business email',text:'Make every message feel a little more professional.',href:'/business-email',kind:'yellow'},
  {num:'05',symbol:'⌘',name:'VPS hosting',text:'Explore more control for growing technical projects.',href:'/vps',kind:'blue'}
];
---
<section class="products-section section-pad" id="solutions">
  <div class="container">
    <div class="section-intro split-intro"><div><span class="eyebrow"><span class="eyebrow-line"></span> THE GOOD STUFF</span><h2>Everything your idea <em>needs to grow.</em></h2></div><p>One launchpad for your digital life. Choose what you're building, and we'll show you where to start.</p></div>
    <div class="product-grid">
      {products.map((product) => <a class:list={['product-card','product-'+product.kind]} href={product.href}>
        <div class="product-card-top"><span>{product.num} / 05</span><span aria-hidden="true" class="product-arrow">↗</span></div>
        <span class="product-symbol" aria-hidden="true">{product.symbol}</span>
        <div><h3>{product.name}</h3><p>{product.text}</p></div>
        <span class="product-footer">Explore service <span aria-hidden="true">↗</span></span>
      </a>)}
    </div>
  </div>
</section>
