---
const products = [
  {num:'02',name:'WordPress Hosting',text:'Build pages, publish updates and manage your WordPress site with familiar tools.',href:'/wordpress-hosting'},
  {num:'03',name:'Domain Names',text:'Find your name and compare first-year and renewal prices before registering.',href:'/domains'},
  {num:'04',name:'Business Email',text:'Use your own domain for professional communication. Ask about current packages.',href:'/business-email'},
  {num:'05',name:'VPS Hosting',text:'Discuss CPU, memory and management needs for more demanding projects.',href:'/vps'}
];
---
<section class="products-section section-pad" id="solutions" aria-labelledby="products-heading">
  <div class="container">
    <div class="section-intro split-intro">
      <div><span class="eyebrow">WHAT CAN WE HELP YOU BUILD?</span><h2 id="products-heading">Everything your site needs, <em>under one roof.</em></h2></div>
      <p>From your first website to the tools that help your business move forward. Choose a service to learn what it includes.</p>
    </div>
    <div class="product-editorial-grid">
      <a href="/shared-hosting" class="product-featured">
        <span class="product-no">01 / SHARED HOSTING</span>
        <div class="product-feature-graphic" aria-hidden="true"><span class="product-building product-building-one"></span><span class="product-building product-building-two"></span><span class="product-building product-building-three"></span></div>
        <div><h3>Well-built hosting for every beginning.</h3><p>NVMe storage, LiteSpeed, cPanel, SSL, daily backups and the option for free cPanel-to-cPanel migration.</p></div>
        <span class="product-discover">Explore shared plans <span aria-hidden="true">↗</span></span>
      </a>
      <div class="product-rows">
        {products.map(item => <a href={item.href} class="product-row">
          <span class="product-no">{item.num}</span>
          <span class="product-row-copy"><strong>{item.name}</strong><span>{item.text}</span></span>
          <span class="product-row-arrow" aria-hidden="true">↗</span>
        </a>)}
      </div>
    </div>
  </div>
</section>
