---
interface Props {
  eyebrow: string;
  title: string;
  accent: string;
  paragraphs: string[];
  points: string[];
  panelLabel: string;
  panelTitle: string;
  panelText: string;
  panelSymbol?: string;
  href?: string;
  actionLabel?: string;
}
const { eyebrow, title, accent, paragraphs, points, panelLabel, panelTitle, panelText, panelSymbol = '✳', href, actionLabel } = Astro.props;
---
<section class="info-split-section section-pad" aria-label={eyebrow}>
  <div class="container info-split-grid">
    <div class="info-split-copy">
      <span class="eyebrow"><span class="eyebrow-line"></span>{eyebrow}</span>
      <h2>{title} <em>{accent}</em></h2>
      {paragraphs.map(p => <p>{p}</p>)}
      <ul class="info-points">{points.map(point => <li><span aria-hidden="true">✓</span>{point}</li>)}</ul>
      {href && <a class="text-link" href={href}>{actionLabel ?? 'Learn more'} <span aria-hidden="true">↗</span></a>}
    </div>
    <div class="info-visual">
      <div class="info-art-circle" aria-hidden="true"></div>
      <span class="info-art-icon" aria-hidden="true">{panelSymbol}</span>
      <div class="info-visual-card"><span>{panelLabel}</span><h3>{panelTitle}</h3><p>{panelText}</p><span class="info-art-bottom" aria-hidden="true">HOSTAMBLE / IDEAS GROW HERE <b>↗</b></span></div>
    </div>
  </div>
</section>
