---
interface Props { title?:string; eyebrow?:string; }
const {title='What your hosting includes',eyebrow='SHARED & WORDPRESS HOSTING'}=Astro.props;
const features=[['NVMe SSD + LiteSpeed','NVMe SSD storage and LiteSpeed web serving power your hosting account.'],['SSL + Imunify360','SSL and Imunify360 are included. Keep your website software updated as well.'],['Automatic daily JetBackup','Automatic daily backups are retained for the most recent three days. Ask support about recovery.'],['cPanel + WordPress','Manage your hosting with cPanel; WordPress installation is available.'],['Free cPanel migration','Free cPanel-to-cPanel migration for eligible accounts. Ask support to review your current hosting.'],['Support availability','Live chat and WhatsApp, Monday–Saturday 9 AM–8 PM IST; support tickets anytime.']];
---
<section class="aceorbit-service ace-service-area ace-section-gap bg-color-white position-relative border-bottom-1" aria-labelledby="feature-heading"><div class="container"><div class="section-title text-center"><span class="pre-title">{eyebrow}</span><h2 class="title" id="feature-heading">{title}</h2></div><div class="row aceorbit-about-one-service g-5 mt--20 justify-content-center">{features.map((f,i)=><div class="col-lg-4 col-md-6 col-12"><div class:list={['service-card','service-card-3','text-left',i%2===0?'shape-bg-1':'shape-bg-2','bg-grey']}><div class="inner"><div class="content"><h3 class="title">{f[0]}</h3><p class="description">{f[1]}</p></div></div></div></div>)}</div></div></section>
