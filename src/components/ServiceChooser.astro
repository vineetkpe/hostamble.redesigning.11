---
const paths = [
  {id:'01', title:'I’m launching a website', detail:'A portfolio, business website, or small project?', dest:'/shared-hosting', cta:'Explore shared hosting',symbol:'▦'},
  {id:'02', title:'I’m creating with WordPress', detail:'A blog, content site, or WordPress-based business?', dest:'/wordpress-hosting', cta:'Explore WordPress plans',symbol:'W'},
  {id:'03', title:'I need a name first', detail:'Start with the domain and build from there.', dest:'/domains', cta:'Find a domain',symbol:'↗'}
];
---
<section class="chooser-section section-pad">
  <div class="container">
    <div class="section-intro split-intro"><div><span class="eyebrow"><span class="eyebrow-line"></span> YOUR NEXT MOVE</span><h2>Not sure where to start? <em>Start here.</em></h2></div><p>Choose the closest match to what you're building. You can always explore other services later.</p></div>
    <div class="chooser-grid">
      {paths.map(path => <a class="chooser-card" href={path.dest}>
        <span class="chooser-top"><b>{path.id} / PICK YOUR PATH</b><span aria-hidden="true">↗</span></span>
        <span class="chooser-symbol" aria-hidden="true">{path.symbol}</span>
        <h3>{path.title}</h3><p>{path.detail}</p>
        <span class="chooser-action">{path.cta}<span aria-hidden="true">→</span></span>
      </a>)}
    </div>
    <p class="chooser-more">Need professional email or more control? Explore <a href="/business-email">business email</a> and <a href="/vps">VPS</a> enquiry options.</p>
  </div>
</section>
