---
interface Props {eyebrow?:string;title:string;description:string;icon?:string;}
const {eyebrow='HOSTAMBLE',title,description}=Astro.props as Props;
---
<section class="inner-hero" aria-label={eyebrow}>
  <div class="container inner-hero-grid">
    <div>
      <span class="eyebrow">{eyebrow}</span>
      <h1>{title}</h1>
      <p>{description}</p>
    </div>
    <div class="inner-hero-art" aria-hidden="true">
      <img src="/brand/open-waypoint.svg" width="180" height="180" alt=""/>
      <b>HOSTAMBLE / OPEN WAYPOINT</b>
    </div>
  </div>
</section>
