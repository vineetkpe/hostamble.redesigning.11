---
const {eyebrow='HOSTAMBLE', title, description, icon='✳'}=Astro.props;
---
<section class="inner-hero">
  <div class="container inner-hero-grid">
    <div>
      <span class="eyebrow light-eyebrow"><span class="pulse-dot"></span> {eyebrow}</span>
      <h1>{title}</h1>
      <p>{description}</p>
    </div>
    <div class="inner-hero-art" aria-hidden="true"><span>{icon}</span><i></i><b>YOUR SPACE TO GROW</b></div>
  </div>
</section>
