---
import {catalog} from '../lib/pricing.mjs';
interface Props { transfer?:boolean; }
const {transfer=false}=Astro.props;
---
<div class="domain-form domain-form-style-1 mt--10 position-relative">
 <form action={catalog.domainSearchUrl} class="input-box text-start" method="get" role="search" aria-label={transfer?'Transfer a domain':'Search domain availability'}>
  <input type="hidden" name="domain" value={transfer?'transfer':'register'}/><input type="hidden" name="a" value="add"/>
  <label class="visually-hidden" for={transfer?'transfer-domain-query':'domain-query'}>Domain name</label>
  <input class="large-input-box" id={transfer?'transfer-domain-query':'domain-query'} name="query" type="text" placeholder="yourname.com" autocomplete="off" required maxlength="253" spellcheck="false" pattern="[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)+" title="Enter a domain such as example.com" />
  <div class="mail-icon"></div><button class="ace-btn" type="submit">{transfer?'Check transfer':'Check availability'}</button>
 </form>
 <p class="description">Live availability, registration terms and final prices are confirmed in the client area.</p>
</div>
