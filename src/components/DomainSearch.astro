---
import catalog from '../data/catalog.json';
import {formatINR} from '../lib/pricing.mjs';
const {compact = false} = Astro.props;
---
<section class:list={['domain-section', compact && 'domain-compact']} id="domain-search">
  <div class="container">
    <div class="domain-panel">
      <div class="domain-heading">
        <span class="eyebrow"><span class="eyebrow-line"></span> FIND YOUR NAME</span>
        <h2>That perfect domain? <em>It's out there.</em></h2>
        <p>A memorable name makes a good first impression. Search yours and continue to Hostamble's live domain checker.</p>
      </div>
      <form class="domain-form" action={catalog.checkout.domainSearch} method="GET" role="search" aria-label="Find a domain">
        <input type="hidden" name="a" value="add" />
        <input type="hidden" name="domain" value="register" />
        <label class="sr-only" for={compact ? 'domain-compact-query' : 'domain-query'}>Domain name</label>
        <span aria-hidden="true" class="domain-magnifier">⌕</span>
        <input id={compact ? 'domain-compact-query' : 'domain-query'} name="query" type="text" placeholder="yourbigidea.com" required autocomplete="off" spellcheck="false" maxlength="253" />
        <button type="submit" class="button button-dark">Search domain <span aria-hidden="true">↗</span></button>
      </form>
      <p class="domain-disclaimer">Availability is checked in the client area. First-year and renewal rates are shown below; verify current prices before ordering.</p>
      <div class="domain-ticker" data-ticker>
        <div class="ticker-runner">
          <span class="ticker-set">
            {catalog.domains.map(item => <span class="domain-rate-card">
              <b>{item.tld}</b>
              <span>First year <strong data-domain-money={item.registerPaise}>{formatINR(item.registerPaise)}</strong></span>
              <span>Renewal / year <strong data-domain-money={item.renewPaise}>{formatINR(item.renewPaise)}</strong></span>
            </span>)}
          </span>
          <span class="ticker-set" aria-hidden="true" inert>
            {catalog.domains.map(item => <span class="domain-rate-card">
              <b>{item.tld}</b>
              <span>First year <strong data-domain-money={item.registerPaise}>{formatINR(item.registerPaise)}</strong></span>
              <span>Renewal / year <strong data-domain-money={item.renewPaise}>{formatINR(item.renewPaise)}</strong></span>
            </span>)}
          </span>
        </div>
        <button type="button" data-ticker-toggle aria-label="Pause domain ticker">Pause motion</button>
      </div>
    </div>
  </div>
</section>
